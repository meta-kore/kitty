# Copy this file to .env and fill it in. Never commit .env.

# PayPal SANDBOX REST app (developer.paypal.com), owned by a sandbox business account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI provider: anthropic, groq, gemini or openrouter
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional: override the provider's default model
# AI_MODEL=
# Optional: any OpenAI-compatible endpoint (used when AI_PROVIDER is not anthropic)
# AI_BASE_URL=

PORT=3000

# Offline UI development only. Never use for the demo.
# PAYPAL_MOCK=1
